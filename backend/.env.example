APP_NAME=EvidenceIQ
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
CORS_ORIGINS=http://localhost:5173
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- A second provider, for Agent 4 only ------------------------------------------
# Agent 4 (Verification) runs on Gemini rather than Groq. Two reasons, same direction:
# it was exhausting Groq's 200000 tokens/day every afternoon while Agent 3 still had
# budget, and a different VENDOR is the strongest form of the rule that Agents 3 and 4
# must not share blind spots - which is what makes "both agents agreed" mean something.
#
# Get a key at https://aistudio.google.com/apikey - the free tier is enough.
# Everything unlisted in LLM_PROVIDER_BY_MODEL keeps using LLM_API_KEY above, so
# Agents 1 and 3 and both chat features are unaffected.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Model ids move - gemini-2.5-flash is already refused for newly issued keys.
# GET {GEMINI_BASE_URL}/models lists what your key can actually reach.
LLM_PROVIDER_BY_MODEL=gemini-3.6-flash=gemini

# Per-model budgets, because the numbers below describe GROQ's free tier and Gemini's
# is shaped differently - far more generous on tokens, metered mainly on requests per
# day. VERIFY THESE IN YOUR OWN CONSOLE: set too high, the pacer waves through calls the
# provider then refuses, which is the exact thing it exists to prevent. Too low is only
# slow. A listed 0 means "this provider does not meter that", not "unset".
LLM_TOKENS_PER_MINUTE_BY_MODEL=gemini-3.6-flash=250000
# Gemini free tier meters REQUESTS per day, not tokens - 20 for this model,
# measured. There is no request bucket here, so it is expressed in tokens:
# 20 requests x ~800 tokens a verification = 16000.
LLM_TOKENS_PER_DAY_BY_MODEL=gemini-3.6-flash=16000
LLM_OUTPUT_TOKENS_PER_MINUTE_BY_MODEL=gemini-3.6-flash=0
# Agent 4 should not share a model with Agent 3 - two agents on one model share its
# blind spots. Check what your key can reach: GET {LLM_BASE_URL}/models
LLM_MODEL=openai/gpt-oss-120b
# Agents 3 and 4. They must differ, and ideally by family and not just by size: two
# checkpoints of one model share its blind spots, so their agreement is weak evidence.
# Quotas are per model, so this also decides which agents compete for the same budget.
SCREENING_MODEL=openai/gpt-oss-20b
# Agent 4's primary. qwen benchmarked fastest and cheapest of the three Groq text
# models on the real verification prompt - see app/core/config.py.
VERIFICATION_MODEL=qwen/qwen3.8-27b

# Where Agent 4 goes when the primary cannot answer, tried in order. A spent
# daily quota then makes a paper slower instead of leaving it with one opinion.
# Every model here must differ from SCREENING_MODEL - the server refuses to start
# otherwise, because a fallback onto Agent 3's model would quietly remove the
# independence that makes agreement mean anything. Empty disables fallback.
# Ordered by how independent the second opinion stays, not by speed. Groq meters per
# model, so each Groq link is a separate 200000/day allowance. The two gpt-oss
# entries share a training lineage with SCREENING_MODEL, so their agreement is
# weaker evidence - the result says so when one of them answers, and they are last
# for that reason. A weak second opinion that admits it still beats none.
VERIFICATION_MODEL_FALLBACKS=gemini-3.6-flash,openai/gpt-oss-120b,openai/gpt-oss-safeguard-20b
# Agent 1's model. Quotas are per model, so this decides who Agent 1 competes with.
# It has gpt-oss-120b to itself now that Agent 4 has moved off it, and at one call per
# review it will not run that budget down.
CRITERIA_MODEL=openai/gpt-oss-120b

# Rate limiting. The provider's token budget is per minute and per model, and calls wait
# for room in it rather than being fired and rejected. Groq's free tier is 8000 TPM on
# each model; raise this to match a paid tier, or set it to 0 to turn pacing off.
LLM_TOKENS_PER_MINUTE=8000
# The limit that actually stops a long run. 200000/day at ~1200 tokens a verification is
# roughly 160 papers. Like the per-minute budget it refills smoothly
# rather than resetting at midnight.
LLM_TOKENS_PER_DAY=200000
# Output tokens per minute, metered separately and usually the tighter limit: 1000/min
# over ~380-token answers is about 2.6 papers a minute whatever the total allows.
# Only set this if your plan actually meters output separately. Groq reports no OTPM
# header for the gpt-oss models (only TPM 8000), and a value set too low silently
# caps every answer at half of it - see _cap_ceiling in app/services/llm.py.
LLM_OUTPUT_TOKENS_PER_MINUTE=8000
# Only a seed - the client measures what answers actually cost and paces on that.
LLM_EXPECTED_OUTPUT_TOKENS=500
# The whole call including retries and provider-requested waits. Keep it under
# AGENT_HTTP_TIMEOUT_SECONDS, or the orchestrator gives up first and the work is wasted.
LLM_DEADLINE_SECONDS=90
# Longest a single call waits for budget before reporting the quota as spent. Keep it
# well under AGENT_HTTP_TIMEOUT_SECONDS, or the caller gives up first and the real reason
# is lost.
LLM_MAX_WAIT_SECONDS=75
# Charged against that budget up front, whether the model uses it or not - so this is
# the largest single lever on how many papers fit in a minute. It is a starting point:
# gpt-oss spends this budget reasoning before it writes any JSON, so when an answer does
# not fit the client doubles the cap up to the ceiling and remembers what was needed.
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_OUTPUT_CEILING=6144
# "low" | "medium" | "high", or blank to not send it. Low keeps reasoning from eating the
# completion budget the JSON then needs; the prompt already fixes the criteria and the
# output shape, so there is little left to reason about.
LLM_REASONING_EFFORT=low
# Per-model overrides, "model=effort" comma separated. Accepted values differ by family
# and so does the cost: gpt-oss takes low|medium|high, qwen takes none|default - and
# qwen3.8 does NOT reject "low", it quietly treats it as full reasoning. Measured on the
# real prompt that is 372 output tokens against 159, i.e. 2.3x the wait per paper.
# gemini-3 reasons by default and MUST be told not to: at none a verification costs
# 91 completion tokens, while omitting the parameter answers 503 with empty content.
LLM_REASONING_EFFORT_BY_MODEL=qwen/qwen3.8-27b=none,qwen/qwen3.6-27b=none,gemini-3.6-flash=
# How many papers are in flight at once. The token budget, not this, sets the rate;
# keeping it low stops a paper waiting behind several others and timing out.
VERIFY_BATCH_CONCURRENCY=2

SUPABASE_URL=https://your-project-ref.supabase.co

# --- Request-level security (app/core/middleware.py) --------------------------------
# Per-client limits on the API itself. The LLM pacer above protects the provider's
# quota; these protect the API from scraping and from one client spending that quota.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# Routes that cost a PubMed or LLM call (retrieval, screening, verification, pipeline,
# criteria interpretation, both chats).
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
# true ONLY behind a proxy that appends the client address to X-Forwarded-For (Render
# does). Left true without one, any client can pick its own rate-limit identity.
TRUST_PROXY_HEADERS=false
# Largest JSON body accepted, refused from Content-Length before it is read.
MAX_REQUEST_BYTES=1000000
MAX_UPLOAD_BYTES=20971520
# Unset = docs on everywhere except ENVIRONMENT=production.
# ENABLE_API_DOCS=false

# --- NCBI E-utilities (optional) ----------------------------------------------------
# A key raises the limit from 3 to 10 requests/second and attributes the traffic.
NCBI_API_KEY=
NCBI_TOOL=EvidenceIQ
NCBI_EMAIL=
