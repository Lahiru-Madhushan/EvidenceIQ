APP_NAME=EvidenceIQ
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
CORS_ORIGINS=http://localhost:5173
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Agent 4 should not share a model with Agent 3 - two agents on one model share its
# blind spots. Check what your key can reach: GET {LLM_BASE_URL}/models
LLM_MODEL=openai/gpt-oss-120b
# Agents 3 and 4. They must differ, and ideally by family and not just by size: two
# checkpoints of one model share its blind spots, so their agreement is weak evidence.
# Quotas are per model, so this also decides which agents compete for the same budget.
SCREENING_MODEL=openai/gpt-oss-20b
VERIFICATION_MODEL=qwen/qwen3.8-27b
# Agent 1's model. Quotas are per model, so this decides who Agent 1 competes with.
# It has gpt-oss-120b to itself now that Agent 4 has moved off it, and at one call per
# review it will not run that budget down.
CRITERIA_MODEL=openai/gpt-oss-120b

# Rate limiting. The provider's token budget is per minute and per model, and calls wait
# for room in it rather than being fired and rejected. Groq's free tier is 8000 TPM on
# each model; raise this to match a paid tier, or set it to 0 to turn pacing off.
LLM_TOKENS_PER_MINUTE=8000
# The limit that actually stops a long run. 200000/day at ~1200 tokens a verification is
# roughly 160 papers. Like the per-minute budget it refills smoothly
# rather than resetting at midnight.
LLM_TOKENS_PER_DAY=200000
# Output tokens per minute, metered separately and usually the tighter limit: 1000/min
# over ~380-token answers is about 2.6 papers a minute whatever the total allows.
# Only set this if your plan actually meters output separately. Groq reports no OTPM
# header for the gpt-oss models (only TPM 8000), and a value set too low silently
# caps every answer at half of it - see _cap_ceiling in app/services/llm.py.
LLM_OUTPUT_TOKENS_PER_MINUTE=8000
# Only a seed - the client measures what answers actually cost and paces on that.
LLM_EXPECTED_OUTPUT_TOKENS=500
# The whole call including retries and provider-requested waits. Keep it under
# AGENT_HTTP_TIMEOUT_SECONDS, or the orchestrator gives up first and the work is wasted.
LLM_DEADLINE_SECONDS=90
# Longest a single call waits for budget before reporting the quota as spent. Keep it
# well under AGENT_HTTP_TIMEOUT_SECONDS, or the caller gives up first and the real reason
# is lost.
LLM_MAX_WAIT_SECONDS=75
# Charged against that budget up front, whether the model uses it or not - so this is
# the largest single lever on how many papers fit in a minute. It is a starting point:
# gpt-oss spends this budget reasoning before it writes any JSON, so when an answer does
# not fit the client doubles the cap up to the ceiling and remembers what was needed.
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_OUTPUT_CEILING=6144
# "low" | "medium" | "high", or blank to not send it. Low keeps reasoning from eating the
# completion budget the JSON then needs; the prompt already fixes the criteria and the
# output shape, so there is little left to reason about.
LLM_REASONING_EFFORT=low
# Per-model overrides, "model=effort" comma separated. Accepted values differ by family
# and so does the cost: gpt-oss takes low|medium|high, qwen takes none|default - and
# qwen3.8 does NOT reject "low", it quietly treats it as full reasoning. Measured on the
# real prompt that is 372 output tokens against 159, i.e. 2.3x the wait per paper.
LLM_REASONING_EFFORT_BY_MODEL=qwen/qwen3.8-27b=none,qwen/qwen3.6-27b=none
# How many papers are in flight at once. The token budget, not this, sets the rate;
# keeping it low stops a paper waiting behind several others and timing out.
VERIFY_BATCH_CONCURRENCY=2

SUPABASE_URL=https://your-project-ref.supabase.co
