APP_NAME=EvidenceIQ
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
CORS_ORIGINS=http://localhost:5173
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Agent 4 should not share a model with Agent 3 - two agents on one model share its
# blind spots. Check what your key can reach: GET {LLM_BASE_URL}/models
LLM_MODEL=openai/gpt-oss-120b
SUPABASE_URL=https://your-project-ref.supabase.co

# Where the orchestrator reaches the other agents. Defaults to this same process on
# whatever port it is listening on (http://127.0.0.1:$PORT), which is right for both
# local development and a single-service deployment. Set it only when the agents live
# somewhere else.
# INTERNAL_API_BASE_URL=https://evidenceiq-backend.onrender.com
